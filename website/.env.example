# Local development only. Copy to .env.local after starting the local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
AUTH_ALLOW_SIGNUP=true

# Needed only to test Google sign-in locally. supabase/config.toml reads
# this via env(GOOGLE_CLIENT_SECRET) -- but the Supabase CLI is a separate
# process from Next.js and does NOT read this file automatically. Export
# it in your shell before starting the stack instead (see SETUP.md):
#   export GOOGLE_CLIENT_SECRET=...   (bash)
#   $env:GOOGLE_CLIENT_SECRET = "..." (PowerShell)
#   pnpm db:start
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
